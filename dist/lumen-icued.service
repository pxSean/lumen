[Unit]
Description=lumen lighting, fan and AIO screen daemon
Documentation=https://github.com/pxSean/lumen

[Service]
# install.sh rewrites this to ~/.local/bin for a per-user build.
ExecStart=/usr/bin/lumen-icued
ExecReload=/bin/kill -HUP $MAINPID
# SIGTERM returns the hub to its onboard fan curve and the LCD to its firmware screen.
KillSignal=SIGTERM
TimeoutStopSec=10
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
